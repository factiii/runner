// GENERATED by `pnpm --filter @factiii/runner vault:schema` from
// apps/server/prisma/schema.prisma. Do not edit: change the server's schema
// and run it again. Relations to models the vault does not keep are dropped;
// their id columns stay, as plain columns.

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

model Upload {
  id                String            @id @default(uuid())
  key               String
  name              String? // original file name
  status            UploadStatus      @default(PUBLISHED)
  createdAt         DateTime          @default(now())
  userId            Int
  type              UploadType
  // File vault (see .specs/file-vault.md). ONEDRIVE-sourced uploads reference the
  // file in the user's OneDrive (externalId = "driveId!itemId") — no S3 copy; bytes
  // are fetched via Graph at ingest/download time. ingestStatus null = not a document.
  uploadSource      UploadSource      @default(S3)
  externalId        String?
  // OneDrive re-embed detection: the source file's cTag captured at embed time.
  // cTag changes only when the file *content* changes, so on re-import we skip
  // files whose cTag still matches and re-embed only those that actually changed.
  sourceCTag        String?
  // How this file's text was obtained. One value per file, not per page: every
  // branch of vaultExtract tags a whole file the same way — a PDF either has a
  // text layer or is OCR'd wholesale, and an image is always described. A
  // video or audio file the device transcribed is SPEECH.
  transcriptSource  TranscriptSource?
  ingestStatus      IngestStatus?
  ingestError       String?
  // Hex SHA-256 of an uploaded vault file's bytes, hashed by the drop drain
  // before it reads anything. A second upload with the same hash is held back as
  // a duplicate until the user picks which copy to keep (.specs/file-vault.md →
  // Duplicates). A synced OneDrive file carries one too, from Graph or from the
  // bytes ingest read, so a sync can follow a re-uploaded file to its new item
  // id; it never takes part in the drop duplicate check. Null on anything else.
  sha256            String?
  // Set when the URLs for a post upload are issued and cleared when a post
  // takes the upload (.specs/uploads.md → Post uploads land private). An upload
  // that still carries it a day later was never attached, and the sweep
  // deletes it. Null on everything that is not a post upload.
  pendingPostAt     DateTime?
  // A premium file whose bytes count against the owner's storage quota
  // (helpers/vaultStorage.ts): a screen recording, or a post upload over the
  // free RAW_UPLOAD_MAX_BYTES. Set when its URLs are issued, never cleared.
  // False on everything else, which stays outside the quota as it always was
  // (.specs/uploads.md → "Premium uploads count against storage").
  chargesStorage    Boolean           @default(false)
  // An admin's waiver of a charged upload (admin.setUploadStorageWaiver): its
  // bytes stop counting against the owner's storage while a post that uses it
  // is public, because the file is then in public use rather than the owner's
  // own. The waiver lapses, and counting resumes, while no such post is public;
  // it comes back if one is again. Cleared by an un-waive. Who waived it is
  // kept beside it, SetNull so deleting that admin keeps the waiver
  // (.specs/uploads.md → "Admin storage waiver").
  storageWaivedAt   DateTime?
  storageWaivedById Int?
  // Set while the server trims a screen recording (helpers/trimUpload.ts) and
  // cleared when the trimmed file has replaced the RAW variant. A post refuses
  // the upload while it is set, so the untrimmed take is never published
  // (.specs/screen-recording.md → Trim).
  trimPendingAt     DateTime?
  // A screen recording sent in parts while it records (S3 multipart,
  // .specs/screen-recording.md → Upload while recording): where it is in its
  // life, moved only by helpers/uploadLifecycle.ts (moveUploadLifecycle),
  // which refuses a move the table there does not allow. Null on every
  // upload sent as one PUT, which has no such life.
  lifecycle         UploadLifecycle?
  // When `lifecycle` last moved, or a part was last signed while UPLOADING:
  // the sweep aborts a take whose parts stopped coming hours ago.
  lifecycleAt       DateTime?
  // The storage's multipart upload id while UPLOADING; cleared once the
  // parts are joined into the object (or aborted).
  multipartId       String?
  // Set when Post asked for the recording's trim and HLS copy
  // (uploads.prepareRecording), so a retried Post never cuts the cut file.
  preparedAt        DateTime?
  // A screen recording's transcript is its post's SPEECH rows (PostContent
  // with this upload's id, .specs/screen-recording.md → Transcript), the same
  // rows and vectors a vault video's words get. Partial: only the first
  // TRANSCRIBE_MAX_SECONDS were heard.
  transcriptPartial Boolean           @default(false)
  speechRows        PostContent[]
  // When the ontology last ran over this file (.specs/oakbox.md → Ontology is
  // manual). Ingest only reads and embeds; tagging is a run the owner starts
  // and pays for, so null on an EMBEDDED file is what "not categorized yet"
  // means.
  ontologyAt        DateTime?
  // Folder this document was synced from (file vault). Un-syncing deletes the
  // VaultFolder row, which cascades its uploads; each upload's post (and that
  // post's SearchVector chunks) is deleted alongside it by the unsync path.
  vaultFolder       VaultFolder?      @relation(fields: [vaultFolderId], references: [id], onDelete: Cascade)
  vaultFolderId     Int?
  productId         Int?
  sourceFactiiiId   Int?
  posts             Post[]            @relation("postUploads") //posts that use this upload
  postFactiiis      PostFactiii[]     @relation("factiiiUploads") //factiiis that use this upload
  mediaVector       MediaVector?

  @@index([productId])
  // User media galleries (upload.findMany by userId) + cascade delete in the
  // account-deletion job (upload.deleteMany by userId). Table grows per image.
  @@index([userId])
  @@index([vaultFolderId])
  @@index([sourceFactiiiId])
  // The duplicate check: "does this user already hold these bytes".
  @@index([userId, sha256])
  @@index([userId, ontologyAt])
  // The unattached-upload sweep: "which post uploads have waited too long".
  @@index([pendingPostAt])
  // The stale multipart sweep: "which takes stopped sending parts".
  @@index([lifecycle, lifecycleAt])
  // The storage sum: "which of this user's uploads count against the quota".
  @@index([userId, chargesStorage])
  @@index([storageWaivedById])
}

model Post {
  id                   Int                @id @default(autoincrement())
  uuid                 String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  //used for blog posts
  slug                 String?            @unique
  title                String?
  userId               Int
  // Made by the author's AI (a runner token), not by them in person. The
  // author is still the user (.specs/ai-actions.md).
  byAi                 Boolean            @default(false)
  // Row 1 of contentRows only, so a list read stays one table and a feed never
  // ships more than one row. clients/prisma.ts splits every write.
  content              String
  // The body, MAX_CONTENT_CHARS a row (.specs/posts.md → "Content rows").
  contentRows          PostContent[]
  createdAt            DateTime           @default(now())
  // @updatedAt auto-bumps on every Prisma write to the row (edits, not reads),
  // so the sitemap <lastmod> reflects when crawlable post content last changed.
  // Counter writes (viewCount, voteCount, trendingRank) therefore go through raw
  // SQL in helpers/counterWrites.ts, which the Prisma client does not stamp.
  updatedAt            DateTime           @default(now()) @updatedAt
  uploads              Upload[]           @relation("postUploads")
  parentPost           Post?              @relation("reply", fields: [parentPostId], references: [id], onDelete: Cascade)
  parentPostId         Int?
  replies              Post[]             @relation("reply")
  status               PostStatus         @default(PUBLISHED)
  // When a DELETED post is due to be scrubbed (.specs/status-enums.md →
  // PostStatus). Every path that deletes a post sets it; null on a DELETED row
  // means it was already scrubbed. Also the end of the author's restore window.
  deletionScheduledAt  DateTime?
  deletedById          Int?
  // The status the delete replaced (PRIVATE, DRAFT, ARCHIVED...), which a
  // restore puts back: a private post or a draft must not come back public.
  statusBeforeDelete   PostStatus?
  // Set by the scrub: content and uploads are gone and the row is a tombstone
  // that nothing may restore.
  scrubbedAt           DateTime?
  trendingRank         Float              @default(0.0)
  voteCount            Int                @default(0)
  viewCount            Int                @default(0)
  repost               Post?              @relation("reference", fields: [repostId], references: [id], onDelete: Cascade)
  repostId             Int?
  reposts              Post[]             @relation("reference")
  spaceId              Int?
  anonymous            Boolean            @default(false)
  factiiis             PostFactiiiCount[]
  // other factiiis can link to posts like lie factiii
  referencedBy         PostFactiii[]      @relation("PostReferences")
  triggeredByFactiiiId Int?
  // Position for board layout ordering (like Trello)
  pos                  Float?
  // Auto-tagging (.specs/auto-tag.md). Null = not read yet: the column is the
  // queue jobs/autoTagJob.ts sweeps. Set once the model has answered, whether
  // or not the answer held a usable tag, so a post is asked about once.
  autoTaggedAt         DateTime?
  // Provider calls that failed for this post. The sweep gives up at
  // AUTO_TAG_MAX_ATTEMPTS, so an outage does not retry one post forever.
  autoTagAttempts      Int                @default(0)

  @@index([spaceId, status])
  @@index(parentPostId)
  @@index([parentPostId, userId]) // For replies count query with userId filter
  @@index(userId)
  @@index(uuid)
  @@index(trendingRank)
  @@index(createdAt)
  @@index(voteCount)
  @@index(triggeredByFactiiiId)
  // Critical composite indexes for feed queries
  @@index([status, parentPostId, trendingRank, id])
  @@index([status, parentPostId, createdAt, id])
  @@index([status, parentPostId, voteCount, id])
  @@index([spaceId, status, parentPostId, trendingRank, id])
  @@index([spaceId, status, parentPostId, createdAt, id])
  @@index([spaceId, status, parentPostId, voteCount, id])
  // Index for board layout ordering
  @@index([spaceId, pos])
  // Index for user queries
  @@index([userId, status, parentPostId, trendingRank, id])
  @@index([userId, status, parentPostId, createdAt, id])
  @@index([userId, status, parentPostId, voteCount, id])
  // Additional index for timeline queries
  @@index([status, createdAt])
  @@index([repostId])
  // The daily scrub: "which deleted posts are due".
  @@index([deletionScheduledAt])
  // The auto-tag sweep: untagged public top-level posts that are not board
  // cards, newest first. Every equality the sweep filters on leads, so the
  // replies and board cards it never tags are not walked each minute.
  @@index([autoTaggedAt, status, parentPostId, pos, createdAt])
}

model PostContent {
  id           Int           @id @default(autoincrement())
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  // 1-based position in the body.
  seq          Int
  text         String
  // 1-based source page for a row cut from a document; null for prose.
  page         Int?
  // This row's search vector, deleted with it.
  searchVector SearchVector?
  // Set on a row of a screen recording's transcript (SPEECH, numbered from
  // SPEECH_SEQ_START): searched and embedded with the post, never part of its
  // body. Null on every body row, which is what body reads and rewrites match.
  upload       Upload?       @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId     String?

  @@unique([postId, seq])
  @@index([uploadId])
}

model SearchVector {
  id            Int                         @id @default(autoincrement())
  // halfvec = float16, half the bytes of vector(768) with the same operators;
  // bge is an fp16 graph, so nothing is lost. Raw SQL casts to ::halfvec here
  // (MediaVector and repVector stay ::vector).
  vector        Unsupported("halfvec(768)")
  // A post is reached only through its content rows — there is no vector for
  // the post itself. The row carries its own position, so there is no seq here,
  // and a rewritten body takes its vectors with it (onDelete: Cascade), so a
  // vector cannot outlive the text it encodes.
  postContentId Int?                        @unique
  postContent   PostContent?                @relation(fields: [postContentId], references: [id], onDelete: Cascade)
  userId        Int?                        @unique
  spaceId       Int?                        @unique
  factiiiId     Int?                        @unique
  productId     Int?                        @unique
  updatedAt     DateTime                    @default(now()) @updatedAt
}

model MediaVector {
  id        Int                        @id @default(autoincrement())
  upload    Upload                     @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId  String                     @unique
  vector    Unsupported("vector(512)")
  updatedAt DateTime                   @default(now()) @updatedAt
}

model VaultFolder {
  id           Int               @id @default(autoincrement())
  userId       Int
  provider     VaultProvider     @default(ONEDRIVE)
  externalId   String // provider folder id (OneDrive Graph itemId, Drive fileId, Dropbox id)
  name         String
  status       VaultFolderStatus @default(PENDING)
  error        String?
  lastSyncedAt DateTime?
  // Where new Oakbox files go (.specs/file-vault.md → Primary storage). At most
  // one per user (helpers/vaultPrimary.ts enforces it); none means R2.
  primary      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  uploads      Upload[]

  @@unique([userId, provider, externalId])
  @@index([userId])
}

model VaultShare {
  id         Int              @id @default(autoincrement())
  ownerId    Int
  memberId   Int
  status     VaultShareStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  @@unique([ownerId, memberId])
  @@index([memberId, status])
}

model PostFactiiiCount {
  id           Int           @id @default(autoincrement())
  count        Int           @default(1) // Count of how many times this factiii has been attached to this post
  postFactiiis PostFactiii[]
  factiiiId    Int
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int

  @@unique([factiiiId, postId])
  @@index([postId, factiiiId])
  @@index([postId]) // Index for batch postId lookups in board view
  @@index([factiiiId]) // Add index for factiiiId lookups
  @@index([factiiiId, postId])
}

model PostFactiii {
  id                 Int               @id @default(autoincrement())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  anonymous          Boolean           @default(false)
  status             PostFactiiiStatus @default(APPROVED)
  data               String?
  // An INTEGER_REQUIRED value. Float, not Int: the requirement has always
  // accepted decimals (a receipt total), and a whole number stores exactly.
  number             Float?
  spaceTimes         SpaceTime[]
  userId             Int
  uploads            Upload[]          @relation("factiiiUploads")
  scrapeId           Int?
  postFactiiiCount   PostFactiiiCount? @relation(fields: [postFactiiiCountId], references: [id], onDelete: Cascade)
  postFactiiiCountId Int?

  // Reference to regular Posts
  references Post[] @relation("PostReferences")

  // meant to relate the post factiii that tags other post factiiis
  // used for bot post factiiis only
  // for example sentiment analysis post factiii can tag angry or happy and we can show on the modal which post factiii's user triggered it.
  triggeredByPostFactiiiId Int?
  triggeredByPostFactiii   PostFactiii?  @relation("botTagged", fields: [triggeredByPostFactiiiId], references: [id], onDelete: Cascade)
  botTaggedPostFactiiis    PostFactiii[] @relation("botTagged")


  clusterId     Int?

  @@index([postFactiiiCountId, userId, status])
  @@index([postFactiiiCountId, status, userId])
  @@index([userId, status, postFactiiiCountId])
  @@index([clusterId])
}

model SpaceTime {
  id               Int         @id @default(autoincrement())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  timestamp        DateTime?
  latitude         Float?
  longitude        Float?
  display          String?
  altitude         Int?
  // Set only when the tagger sent a receipt from verification.attestLocation
  // for exactly this latitude, longitude and time: the app on an attested
  // device read it from the OS. Null for a typed or edited location.
  deviceVerifiedAt DateTime?
  postFactiii      PostFactiii @relation(fields: [postFactiiiId], references: [id], onDelete: Cascade)
  postFactiiiId    Int

  @@index([postFactiiiId])
}

enum UploadType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum UploadLifecycle {
  UPLOADING
  UPLOADED
  POSTED
  DISCARDED
  FAILED
}

enum UploadStatus {
  PUBLISHED
  DELETED
  S3_MISSING //Was in DB, but not S3 bucket
  DB_MISSING //Was in S3 bucket, but not DB
  SOURCE_MISSING //External hot-linked source (e.g. scraped Wikipedia URL) permanently unavailable (4xx). Skipped by embedding; rendered as a branded placeholder.
}

enum UploadSource {
  S3
  ONEDRIVE
  GOOGLE_DRIVE
  DROPBOX
}

enum IngestStatus {
  PENDING // registered, extraction queued
  EMBEDDED // transcript + chunks complete
  FAILED // extraction/embedding failed — reason in ingestError, retryable
}

enum TranscriptSource {
  TEXT_LAYER // pulled from the file's own text (pdf text layer, docx, xlsx)
  OCR // Apple Vision OCR over scans/photos
  VISION // a vision model read the file (images, and any page with no text)
  SPEECH // the device transcribed a video's or audio file's speech before upload
}

enum VaultFolderStatus {
  PENDING // tracked, first sync not finished yet
  SYNCING // a sync run is walking + embedding this folder now
  SYNCED // last sync completed; change token captured
  ERROR // last sync failed (reason in `error`)
}

enum VaultProvider {
  ONEDRIVE
  GOOGLE_DRIVE
  DROPBOX
  // Oakbox (.specs/oakbox.md): we hold the bytes ourselves. There is no folder
  // to walk and no provider to reconnect — the single S3 row per user exists so
  // an Oakbox upload is reachable by the same `Upload.vaultFolderId` foreign key
  // the OneDrive vault uses, instead of a key-prefix scan.
  S3
}

enum VaultShareStatus {
  PENDING // invited, not accepted yet
  ACCEPTED // the member sees the owner's vault, and the owner theirs
}

enum PostStatus {
  PUBLISHED //Post is visible to all, if this is missing it cannot be seen
  PRIVATE //Post is only visible to logged in user
  DELETED //post deleted by user; deletedContentScrubJob scrubs it once deletionScheduledAt passes
  DRAFT //Post held in draft for user
  ARCHIVED //Hidden from every feed, search and list; the author restores it to PUBLISHED
}

enum PostFactiiiStatus {
  PENDING // If people want to use pending this acts like a QUEUE
  APPROVED // Factiii is APPROVED to display
  REJECTED // Factiii is REJECTED and will not display to anyone besides the user who submitted it and the moderators
  RETIRED // Factiii is RETIRED and will only display if RETIRED is requested
  DELETED // PostFactiii is soft deleted
}
