{
  // The runner's own compiler settings (apps/runner/tsconfig.json): esbuild
  // compiles each file by its nearest tsconfig, so ES2022 here keeps the
  // class-field semantics these files had inside apps/runner. Node only: the
  // core runs on the runner, never in a browser; the server imports only the
  // vault router's files (index.ts, prismaDb.ts, skippedFolders.ts) and
  // compiles them with its own settings. No path alias to apps/server, unlike
  // shared/all: this package runs on the server and on the runner, and must
  // not reach either one's code. Each backend hands the router what it needs
  // through the ports (ports.ts).
  "extends": "@configs/typescript/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,
    // Server files the vault router's imports reach type-check here too, and
    // the server imports file-type 22 and unpdf 2, which publish types only
    // through an `exports` map that `moduleResolution: "node"` never reads.
    // Type-checking only: no file here imports either at runtime.
    "paths": {
      "file-type": ["../../node_modules/file-type/source/index.d.ts"],
      "unpdf": ["../../node_modules/unpdf/dist/index.d.mts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
