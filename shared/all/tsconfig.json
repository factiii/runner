{
  "extends": "@configs/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2018",
    "lib": ["es2022"],
    "types": [],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "paths": {
      "superjson": ["../../node_modules/superjson"],
      "superjson/dist": ["../../node_modules/superjson/dist"]
    }
  },
  "include": [
    "validators.ts",
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
