#!/usr/bin/env node
/**
 * factiii-secrets - run a command with this space's stored secrets injected.
 *
 * A PROXY, never a carrier. This process asks the runner to run the command
 * and names the keys that command needs; the runner is what holds the
 * decrypted values, execs the command with just those in its env, and sends
 * back output already redacted. Nothing secret ever enters this process, so
 * nothing secret is visible to whatever spawned it - which is the whole point,
 * because what spawns it is an AI agent.
 *
 * Finding the runner doubles as the gate: this plugin installs globally, so
 * outside a factiii space there is no socket and the command says so rather
 * than hanging.
 */
'use strict';

const fs = require('fs');
const net = require('net');
const path = require('path');

const SOCK_NAME = 'secrets.sock';
/** Denial is not a command failure: a distinct code lets a script tell "the
 *  owner said no" from "the command ran and failed". */
const EXIT_DENIED = 77;
/** Nothing ran at all - no socket, no runner, bad usage. */
const EXIT_UNAVAILABLE = 3;

function usage() {
  process.stderr.write(
    [
      'usage:',
      '  factiii-secrets run --key NAME [--key NAME]... [--file NAME]... -- <command...>',
      '        run it with the values for exactly those keys in its environment',
      '        and each --file secret as a private temp file whose path is in $NAME',
      '  factiii-secrets list',
      '        print the key NAMES the store holds, and their status (never values)',
      '',
      'Only the keys you name are injected. --key takes one name, repeats, and',
      'accepts a comma-separated list; so does --file. Naming none runs the',
      'command with no secrets at all. A --file is deleted when the command ends.',
      ''
    ].join('\n')
  );
}

/** The one host git's credential helper answers for: the GitHub connection's
 *  token is never offered anywhere else. */
const GIT_CREDENTIAL_HOST = 'github.com';

/**
 * git's credential helper protocol on stdin: `key=value` lines up to a blank
 * line or the end. Only the first value of a key is kept; the multi-valued
 * keys (`capability[]`, `wwwauth[]`) are not needed here.
 */
function parseCredentialRequest(text) {
  const fields = {};
  for (const line of text.split('\n')) {
    const clean = line.replace(/\r$/, '');
    if (!clean) break;
    const eq = clean.indexOf('=');
    if (eq <= 0) continue;
    const key = clean.slice(0, eq);
    if (!(key in fields)) fields[key] = clean.slice(eq + 1);
  }
  return fields;
}

/** Everything on stdin, as text. git closes it after the request. */
function readStdin() {
  return new Promise((resolve) => {
    let text = '';
    process.stdin.setEncoding('utf-8');
    process.stdin.on('data', (chunk) => (text += chunk));
    process.stdin.on('end', () => resolve(text));
    process.stdin.on('error', () => resolve(text));
  });
}

/** What a shell variable may be called, and so what the runner will accept. */
const KEY_PATTERN = /^[A-Za-z_][A-Za-z0-9_]*$/;

/**
 * Split `--key` and `--file` out of the caller's argv.
 *
 * Only the flags BEFORE the command are ours: everything from the first
 * non-flag word (or from `--`) belongs to the command, which may well have a
 * `--key` of its own.
 */
function parseKeys(argv) {
  const keys = [];
  const files = [];
  let i = 0;
  for (; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--') {
      i += 1;
      break;
    }
    let raw;
    let into;
    let flag;
    if (arg === '--key' || arg === '--file') {
      flag = arg;
      into = arg === '--key' ? keys : files;
      i += 1;
      if (i >= argv.length) return { error: `${flag} needs a name.` };
      raw = argv[i];
    } else if (arg.startsWith('--key=')) {
      into = keys;
      raw = arg.slice('--key='.length);
    } else if (arg.startsWith('--file=')) {
      into = files;
      raw = arg.slice('--file='.length);
    } else {
      break;
    }
    for (const name of raw.split(',')) {
      const key = name.trim();
      if (!key) continue;
      if (!KEY_PATTERN.test(key)) {
        return { error: `"${key}" is not a valid key name.` };
      }
      if (!into.includes(key)) into.push(key);
    }
  }
  const both = files.find((name) => keys.includes(name));
  if (both) {
    return { error: `${both} is named as both a --key and a --file.` };
  }
  return { keys, files, rest: argv.slice(i) };
}

/**
 * `NAME   status   title` rows, aligned, each followed by its description
 * indented underneath.
 *
 * The description is the reason to run this at all: a bare name says a
 * credential exists, not which command wants it or what breaks without it.
 * Older runners send no description, so every field here is optional and an
 * undescribed store still prints exactly the rows it used to.
 */
function formatKeys(entries) {
  const width = entries.reduce((max, e) => Math.max(max, e.key.length), 0);
  // Each board has its own store; say whose this is, so a runner serving
  // several boards never reads as one list. FACTIII_SPACE is set in every
  // runner session.
  const board = boardName();
  const lines = board
    ? [`Secrets for the board ${board} (no other board's jobs can read them):`, '']
    : [];
  for (const entry of entries) {
    const status = [
      entry.stored ? 'set' : 'not set',
      // Stored, and no required-variables.json asks for it: a candidate to
      // delete. A file row from an older runner says neither, so it stays
      // quiet about it.
      ...(entry.kind === 'file' && !entry.declared
        ? []
        : [entry.declared ? 'declared' : entry.stored ? 'undeclared, nothing asks for it' : 'undeclared']),
      ...(entry.kind === 'file' ? ['file (--file)'] : []),
      // A similar undeclared name the store does hold: likely the same
      // credential stored under the wrong name (similarSecretKey.ts).
      ...(entry.storedAs ? [`the store has ${entry.storedAs}: same credential under another name?`] : [])
    ].join(', ');
    const title = entry.title ? `  ${entry.title}` : '';
    lines.push(`${entry.key.padEnd(width)}  ${status}${title}`);
    if (entry.description) {
      lines.push(`${' '.repeat(width + 2)}${entry.description}`);
    }
  }
  return lines.join('\n');
}

/**
 * The board this session runs for, as a person knows it: the space's name,
 * its slug after it. Read from the runner's spaces.json
 * (`<runner dir>/<board>/state/secrets.sock` -> `<runner dir>/spaces.json`;
 * apps/runner/src/boardRegistry.ts owns the shape), by FACTIII_SPACE_ID, else
 * by FACTIII_SPACE as a slug the board has or had: a terminal keeps the env it
 * started with, and a rename since then changed both. FACTIII_SPACE alone
 * when the runner knows no name.
 */
function boardName() {
  const slug = process.env.FACTIII_SPACE || '';
  const id = process.env.FACTIII_SPACE_ID || '';
  const sock = process.env.FACTIII_SECRETS_SOCK;
  if (!sock || (!slug && !id)) return slug;
  let registry;
  try {
    const file = path.join(path.dirname(path.dirname(path.dirname(sock))), 'spaces.json');
    registry = JSON.parse(fs.readFileSync(file, 'utf-8'));
  } catch {
    return slug;
  }
  if (!registry || typeof registry !== 'object') return slug;
  const entries = Object.values(registry).filter((e) => e && typeof e === 'object' && e.slug);
  const board =
    (id && registry[id] && typeof registry[id] === 'object' ? registry[id] : null) ||
    entries.find((e) => e.slug === slug) ||
    entries.find((e) => Array.isArray(e.was) && e.was.includes(slug));
  if (!board) return slug;
  if (typeof board.name !== 'string' || !board.name) return board.slug;
  return board.name.toLowerCase() === board.slug.toLowerCase() ? board.name : `${board.name} (${board.slug})`;
}

/** `<spaceDir>/state/secrets.sock`. The env var is what the runner sets on
 *  every spawn; the walk-up covers a caller that changed the working
 *  directory to somewhere the runner did not choose. */
function findSocket() {
  const fromEnv = process.env.FACTIII_SECRETS_SOCK;
  if (fromEnv) return fromEnv;
  let dir = process.cwd();
  while (dir && dir !== path.dirname(dir)) {
    const candidate = path.join(dir, 'state', SOCK_NAME);
    try {
      if (fs.statSync(candidate).isSocket()) return candidate;
    } catch {
      // Not here; keep walking.
    }
    dir = path.dirname(dir);
  }
  return null;
}

/**
 * Rebuild one shell word.
 *
 * The runner runs the command through a login shell and shows it to the owner
 * verbatim for authorization, so what we send has to mean exactly what the
 * caller's argv meant. Single quotes make every character literal; the only
 * thing that cannot appear inside them is a single quote, which is spliced.
 * Words that need no quoting are left bare so the authorization card stays
 * readable.
 */
function shellQuote(word) {
  if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(word)) return word;
  return `'${word.split("'").join(`'\\''`)}'`;
}

/** One NDJSON request, its stream of replies handled by `onMessage`. */
function request(socketPath, payload, onMessage) {
  return new Promise((resolve) => {
    const conn = net.createConnection(socketPath);
    let buffer = '';
    let settled = false;
    const finish = (code) => {
      if (settled) return;
      settled = true;
      conn.end();
      resolve(code);
    };

    conn.on('connect', () => conn.write(`${JSON.stringify(payload)}\n`));
    conn.on('data', (chunk) => {
      buffer += chunk.toString('utf-8');
      let newline = buffer.indexOf('\n');
      while (newline !== -1) {
        const line = buffer.slice(0, newline);
        buffer = buffer.slice(newline + 1);
        if (line.trim()) {
          let message;
          try {
            message = JSON.parse(line);
          } catch {
            // A malformed frame is the runner's bug, not the caller's; there
            // is nothing useful to do with half a message.
            message = null;
          }
          if (message) {
            const code = onMessage(message);
            if (typeof code === 'number') finish(code);
          }
        }
        newline = buffer.indexOf('\n');
      }
    });
    conn.on('error', (err) => {
      // The path can be known and still have nothing listening: the space is
      // down, or still provisioning. The store is served for as long as the
      // space is up now, so this is a state to wait out, not a place to be.
      const why =
        err.code === 'ENOENT' || err.code === 'ECONNREFUSED'
          ? 'the secrets store is not being served right now. The space serves it whenever it is up, so this usually means it is still starting'
          : `cannot reach the runner (${err.message})`;
      process.stderr.write(`factiii-secrets: ${why}.\n`);
      finish(EXIT_UNAVAILABLE);
    });
    // Closed with no verdict: the runner died, or the work was cancelled
    // mid-command. Either way nothing was reported as finished.
    conn.on('close', () => finish(EXIT_UNAVAILABLE));
  });
}

async function main() {
  const [op, ...rest] = process.argv.slice(2);

  if (!op || op === '-h' || op === '--help') {
    usage();
    return op ? 0 : EXIT_UNAVAILABLE;
  }
  if (
    op !== 'run' &&
    op !== 'list' &&
    op !== 'tunnel-token' &&
    op !== 'git-credential'
  ) {
    process.stderr.write(`factiii-secrets: unknown command "${op}".\n`);
    usage();
    return EXIT_UNAVAILABLE;
  }

  // git's credential helper (`credential.https://github.com.helper` in the
  // clone's config): `git-credential get|store|erase`, the request on stdin.
  // Only `get` for github.com over https is answered, with the board's GitHub
  // token as the runner holds it now; `store` and `erase` are no-ops, because
  // the runner owns the token and nothing here may keep a copy. Any other host
  // gets no answer, so git goes on to its next way of asking.
  if (op === 'git-credential') {
    const action = rest[0];
    const fields = parseCredentialRequest(await readStdin());
    if (action !== 'get') return 0;
    if (fields.protocol !== 'https' || fields.host !== GIT_CREDENTIAL_HOST) {
      return 0;
    }
    const gitSocket = findSocket();
    if (!gitSocket) {
      process.stderr.write(
        'factiii-secrets: no runner is reachable here, so there is no GitHub credential.\n'
      );
      return EXIT_UNAVAILABLE;
    }
    return request(
      gitSocket,
      { op: 'git-credential', token: process.env.FACTIII_SECRETS_TOKEN || '' },
      (message) => {
        if (message.type === 'git-credential' && message.password) {
          process.stdout.write(
            `username=x-access-token\npassword=${message.password}\n`
          );
          return 0;
        }
        if (message.type === 'error') {
          process.stderr.write(`factiii-secrets: ${message.message}\n`);
          return EXIT_UNAVAILABLE;
        }
      }
    );
  }

  const socketPath = findSocket();
  if (!socketPath) {
    process.stderr.write(
      'factiii-secrets: no secrets store is reachable here. This command works inside a session a factiii runner started.\n'
    );
    return EXIT_UNAVAILABLE;
  }

  // Not in the usage text on purpose: this is `factiii-expose` talking to the
  // runner, not something to run by hand. It prints the runner's access token
  // as it is now, which frpc presents to open a tunnel. The runner gives it
  // only to a session it spawned, and nothing here writes it anywhere.
  if (op === 'tunnel-token') {
    return request(
      socketPath,
      { op: 'tunnel-token', token: process.env.FACTIII_SECRETS_TOKEN || '' },
      (message) => {
        if (message.type === 'tunnel-token' && message.token) {
          process.stdout.write(`${message.token}\n`);
          return 0;
        }
        if (message.type === 'error') {
          process.stderr.write(`factiii-secrets: ${message.message}\n`);
          return EXIT_UNAVAILABLE;
        }
      }
    );
  }

  if (op === 'list') {
    return request(socketPath, { op: 'list' }, (message) => {
      if (message.type === 'keys') {
        // `entries`: each key with its status.
        const rows = formatKeys(Array.isArray(message.entries) ? message.entries : []);
        if (rows) process.stdout.write(`${rows}\n`);
        return 0;
      }
      if (message.type === 'error') {
        process.stderr.write(`factiii-secrets: ${message.message}\n`);
        return EXIT_UNAVAILABLE;
      }
    });
  }

  // `--` ends our flags and starts the command. It is optional - the first
  // word that is not a `--key` also ends them - but it is what keeps a command
  // of its own beginning with `--key`/`-e`/`--prod` from being read as ours.
  const parsed = parseKeys(rest);
  if (parsed.error) {
    process.stderr.write(`factiii-secrets: ${parsed.error}\n`);
    usage();
    return EXIT_UNAVAILABLE;
  }
  const argv = parsed.rest;
  if (!argv.length) {
    process.stderr.write('factiii-secrets: run needs a command.\n');
    usage();
    return EXIT_UNAVAILABLE;
  }
  // Naming no key is allowed, not corrected: the wrapper then buys nothing, so
  // say so once rather than guess at a scope the caller did not ask for.
  if (!parsed.keys.length && !parsed.files.length) {
    process.stderr.write(
      'factiii-secrets: no --key or --file given, so this command gets no secrets. Run `factiii-secrets list` for the names.\n'
    );
  }

  const command = argv.map(shellQuote).join(' ');
  return request(
    socketPath,
    {
      op: 'run',
      command,
      cwd: process.cwd(),
      keys: parsed.keys,
      // File secrets: each arrives as a 0600 temp file, its path in $NAME,
      // deleted when the command ends. An older runner ignores this field.
      files: parsed.files,
      // Proves which session is asking. The runner sets it on every session it
      // spawns; a caller it did not spawn has none and is refused rather than
      // put in front of the owner as an anonymous password prompt.
      token: process.env.FACTIII_SECRETS_TOKEN || ''
    },
    (message) => {
      if (message.type === 'status') {
        // stderr, so a caller capturing stdout gets the command's output and
        // nothing of ours.
        process.stderr.write(`factiii-secrets: ${message.text}\n`);
        return;
      }
      if (message.type === 'output') {
        process.stdout.write(message.chunk);
        return;
      }
      if (message.type === 'denied') {
        process.stderr.write(
          'factiii-secrets: the owner declined to run that command.\n'
        );
        return EXIT_DENIED;
      }
      if (message.type === 'error') {
        process.stderr.write(`factiii-secrets: ${message.message}\n`);
        return EXIT_UNAVAILABLE;
      }
      if (message.type === 'exit') return message.code;
    }
  );
}

main().then(
  (code) => {
    process.exitCode = code;
  },
  (err) => {
    process.stderr.write(`factiii-secrets: ${err && err.message}\n`);
    process.exitCode = EXIT_UNAVAILABLE;
  }
);
